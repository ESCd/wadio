@using Microsoft.Extensions.ObjectPool
@using Wadio.Platform.Web.UI.Components.Routing

@page "/"

@inherits StatefulComponent<DiscoverState>

@inject IWadioApi Api
@inject IAsyncCache Cache
@inject ObjectPool<HashSet<Guid>> GuidSetPool
@inject NavigationManager Navigation

<HeadContent>
    @foreach (var url in GetStationPrefetchUrls(Navigation, GuidSetPool, State))
    {
        <link rel="preload" href="@url" as="image" @key="@url" />
    }
</HeadContent>

<Page Title="Discover">
    <div class="flex flex-col space-y-5">
        @StationCarousel(State.Popular, StationOrderBy.MostPlayed)
        @StationCarousel(State.Trending, StationOrderBy.Trending)
        @StationCarousel(State.RecentlyUpdated, StationOrderBy.RecentlyUpdated)
        @StationCarousel(State.Random, StationOrderBy.Random)
    </div>
</Page>

@code {

    [CascadingParameter]
    public PlayerContext PlayerContext { get; init; } = default!;

    private static IEnumerable<Uri> GetStationPrefetchUrls(NavigationManager navigation, ObjectPool<HashSet<Guid>> pool, DiscoverState state)
    {
        ArgumentNullException.ThrowIfNull(navigation);
        ArgumentNullException.ThrowIfNull(pool);
        ArgumentNullException.ThrowIfNull(state);

        var keys = pool.Get();
        try
        {
            foreach (var url in Enumerate(navigation, state.Trending, keys))
            {
                yield return url;
            }

            foreach (var url in Enumerate(navigation, state.Popular, keys))
            {
                yield return url;
            }

            foreach (var url in Enumerate(navigation, state.RecentlyUpdated, keys))
            {
                yield return url;
            }

            foreach (var url in Enumerate(navigation, state.Random, keys))
            {
                yield return url;
            }
        }
        finally
        {
            pool.Return(keys);
        }

        static IEnumerable<Uri> Enumerate(NavigationManager navagation, StationCarouselData data, HashSet<Guid> keys)
        {
            ArgumentNullException.ThrowIfNull(navagation);
            ArgumentNullException.ThrowIfNull(data);

            foreach (var station in data.Value)
            {
                if (keys.Add(station.Id))
                {
                    yield return navagation.GetStationIconUrl(station.Id);
                }
            }
        }
    }

    private Uri GetViewMoreUrl(StationOrderBy order) => Navigation.ToAbsoluteUri(Navigation.GetUriWithQueryParameters("/search", new Dictionary<string, object?>
    {
        [nameof(Pages.Search.Order)] = (int)order
    }));

    protected override async Task OnInitializedAsync()
    {
        if (!TryRestoreFromPersistence())
        {
            await Mutate((state, cancellation) => DiscoverState.Load(Api.Stations, Cache, state, cancellation));
        }
    }

    public RenderFragment StationCarousel(StationCarouselData data, StationOrderBy order)
    {
        var label = EnumDisplay.GetName(order);
        var viewMore = GetViewMoreUrl(order);
        return __builder =>
        {
            <StationCarousel Data="@data" Label="@label" Placeholders="@DiscoverState.StationCount" ViewMoreUrl="@viewMore" />
        };
    }

}