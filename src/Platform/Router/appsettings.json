{
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          },
          {
            "RequestHeaderOriginalHost": "true"
          },
          {
            "X-Forwarded": "Set",
            "HeaderPrefix": "X-Forwarded-"
          },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/api"
          }
        ]
      },
      "web-route": {
        "ClusterId": "web",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          },
          {
            "X-Forwarded": "Set"
          }
        ]
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "destination1": {
            "Address": "http://api"
          }
        },
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "AffinityKeyName": ".SignalR.Affinity"
        }
      },
      "web": {
        "Destinations": {
          "destination1": {
            "Address": "http://web"
          }
        }
      }
    }
  }
}