<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <ContainerRepository>ESCd/wadio-discord</ContainerRepository>
    <EnableSdkContainerDebugging Condition=" '$(Configuration)' == 'Debug' ">True</EnableSdkContainerDebugging>
    <NetCordVersion>1.0.0-alpha.479</NetCordVersion>
    <OptimizationPreference>Speed</OptimizationPreference>
    <PublisAot>true</PublisAot>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>true</PublishTrimmed>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TrimMode>partial</TrimMode>
    <UserSecretsId>WADIO-DISCORD-e60059f3-c042-4917-975d-ecd141484e3e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="libsodium" Version="1.0.21" />
    <PackageReference Include="NetCord" Version="$(NetCordVersion)" />
    <PackageReference Include="NetCord.Hosting" Version="$(NetCordVersion)" />
    <PackageReference Include="NetCord.Hosting.Services" Version="$(NetCordVersion)" />
    <PackageReference Include="Open.ChannelExtensions" Version="9.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(WadioDirectory)\src\Extensions\Icecast\Wadio.Extensions.Icecast.csproj" />
    <ProjectReference Include="$(WadioDirectory)\src\Platform\Abstractions\Wadio.Platform.Abstractions.csproj" />
    <ProjectReference Include="$(WadioDirectory)\src\Platform\Api\Client\Wadio.Platform.Api.Client.csproj" />
    <ProjectReference Include="$(WadioDirectory)\src\Platform\Hosting\Wadio.Platform.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="lib\**\*.*" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>runtimes\%(RecursiveDir)\native\%(Filename)%(Extension)</Link>
      <TargetPath>runtimes\%(RecursiveDir)\native\%(Filename)%(Extension)</TargetPath>
    </Content>

    <NativeLibrary Include="lib\$(RuntimeIdentifier)\*.*" Condition=" '$(RuntimeIdentifier)' != '' " />

    <DirectPInvoke Include="libdave" />
    <DirectPInvoke Include="libopus" />
    <DirectPInvoke Include="libsodium" />
    <DirectPInvoke Include="opus" />
  </ItemGroup>

  <ItemGroup Condition=" '$(RuntimeIdentifier)' == 'linux-x64' AND '$(WADIO_BUILD_IN_CONTAINER)' == 'true' ">
    <Content Include="/usr/lib/x86_64-linux-gnu/libdave.*;/usr/lib/x86_64-linux-gnu/libopus.*;/usr/lib/x86_64-linux-gnu/libsodium.*;/usr/lib/x86_64-linux-gnu/opus.*" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>runtimes\linux-x64\native\%(Filename)%(Extension)</Link>
      <TargetPath>runtimes\linux-x64\native\%(Filename)%(Extension)</TargetPath>
    </Content>

    <NativeLibrary Include="lib/linux-x64/*.*" />
    <NativeLibrary Include="/usr/lib/x86_64-linux-gnu/libdave.*" />
    <NativeLibrary Include="/usr/lib/x86_64-linux-gnu/libopus.*" />
    <NativeLibrary Include="/usr/lib/x86_64-linux-gnu/libsodium.*" />
    <NativeLibrary Include="/usr/lib/x86_64-linux-gnu/opus.*" />

    <!-- <DirectPInvoke Include="libdave" />
    <DirectPInvoke Include="libopus" />
    <DirectPInvoke Include="libsodium" />
    <DirectPInvoke Include="opus" /> -->
  </ItemGroup>

</Project>